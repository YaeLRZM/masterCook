// master-cook — Prisma Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USER / AUTH ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CHEF
  VIEWER
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String   // bcrypt hash
  role      Role     @default(CHEF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[] @relation("UserAudit")
}

// ─── UNITS & CONVERSIONS ──────────────────────────────────────────────────────

enum UnitType {
  MASS
  VOLUME
  UNIT
}

model Unit {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Kilogram"
  symbol      String   @unique // e.g. "kg"
  type        UnitType
  baseUnit    String?  // symbol of the base unit (for conversions)
  toBase      Float    @default(1) // multiply by this to get base unit value

  ingredientsPurchase Ingredient[] @relation("PurchaseUnit")
  ingredientsRecipe   Ingredient[] @relation("RecipeUnit")
  recipeIngredients   RecipeIngredient[]
}

// ─── CATEGORIES ───────────────────────────────────────────────────────────────

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String       @default("#465fff")
  icon        String?

  ingredients Ingredient[]
  recipes     Recipe[]
}

// ─── INGREDIENTS ──────────────────────────────────────────────────────────────

model Ingredient {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])

  // Purchasing
  purchaseUnitId       String
  purchaseUnit         Unit     @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  pricePerPurchaseUnit Float    // cost per purchase unit

  // Recipe conversion
  recipeUnitId         String
  recipeUnit           Unit     @relation("RecipeUnit", fields: [recipeUnitId], references: [id])
  conversionFactor     Float    // how many recipe units per 1 purchase unit (e.g. 1000 ml / 1 L)

  // Yield / Merma
  yieldPercentage      Float    @default(100) // 0–100: net usable after prep (e.g. 80 for 20% waste)

  isActive             Boolean  @default(true)
  supplier             String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
}

// ─── RECIPES ──────────────────────────────────────────────────────────────────

enum PricingMethod {
  FIXED_MARGIN    // sell = cost / (1 - margin%)
  MULTIPLIER      // sell = cost × factor
  MANUAL          // price set by hand
}

model Recipe {
  id              String        @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?

  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])

  servings        Int           @default(1)
  preparationTime Int?          // minutes
  cookingTime     Int?          // minutes

  // Costs (auto-calculated on save)
  directCost      Float         @default(0) // sum of ingredients
  indirectCost    Float         @default(0) // sum of indirect costs
  totalCost       Float         @default(0) // direct + indirect

  // Pricing
  pricingMethod   PricingMethod @default(MULTIPLIER)
  marginPercentage Float?       // used when pricingMethod = FIXED_MARGIN
  multiplierFactor Float?       @default(3) // used when pricingMethod = MULTIPLIER
  sellingPrice    Float         @default(0)

  // Sub-recipe flag: can this recipe be used as an ingredient in another?
  isSubRecipe     Boolean       @default(false)

  // Audit
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?
  updatedBy       String?

  ingredients     RecipeIngredient[]
  indirectCosts   IndirectCost[]
  eventRecipes    EventRecipe[]
  auditLogs       AuditLog[]    @relation("RecipeAudit")
}

// ─── RECIPE INGREDIENTS (supports sub-recipes) ───────────────────────────────

model RecipeIngredient {
  id              String      @id @default(cuid())
  recipeId        String
  recipe          Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // Either an ingredient OR a sub-recipe — enforced at app level
  ingredientId    String?
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id])
  subRecipeId     String?     // points to another Recipe.id (must have isSubRecipe=true)

  // Quantities
  quantity        Float
  unitId          String
  unit            Unit        @relation(fields: [unitId], references: [id])

  // Calculated on save
  grossWeight     Float       @default(0)  // quantity before merma
  netWeight       Float       @default(0)  // grossWeight × (yieldPct/100)
  yieldPct        Float       @default(100)
  unitCost        Float       @default(0)  // cost per recipe unit
  totalCost       Float       @default(0)  // unitCost × grossWeight

  notes           String?
  order           Int         @default(0)  // display order

  @@index([recipeId])
  @@index([ingredientId])
}

// ─── INDIRECT COSTS ───────────────────────────────────────────────────────────

enum IndirectCostType {
  LABOR      // mano de obra (per hour or per batch)
  ENERGY     // gas, luz
  PACKAGING  // envases, embalaje
  OVERHEAD   // gastos generales fijos
  OTHER
}

enum IndirectCostBasis {
  PER_BATCH   // fixed amount per recipe run
  PERCENTAGE  // % of direct ingredient cost
}

model IndirectCost {
  id          String            @id @default(cuid())
  recipeId    String
  recipe      Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name        String
  type        IndirectCostType  @default(OTHER)
  basis       IndirectCostBasis @default(PER_BATCH)
  amount      Float             // value (currency or %)
  totalCost   Float             @default(0) // calculated

  @@index([recipeId])
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  QUOTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Event {
  id               String      @id @default(cuid())
  name             String
  clientName       String
  clientEmail      String?
  clientPhone      String?
  eventDate        DateTime
  guestCount       Int

  status           EventStatus @default(DRAFT)

  // Costs (recalculated when guestCount changes)
  totalCost        Float       @default(0)
  costPerPerson    Float       @default(0)
  quotedPrice      Float       @default(0)
  pricePerPerson   Float       @default(0)

  termsConditions  String?     // text shown in PDF quote
  staffCount       Int?
  staffCostTotal   Float?

  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String?

  recipes          EventRecipe[]
  auditLogs        AuditLog[]  @relation("EventAudit")
}

// ─── EVENT RECIPES (dishes per event with per-guest scaling) ──────────────────

model EventRecipe {
  id          String  @id @default(cuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id])

  // Scaling: how many servings needed for guestCount guests
  servingsPerGuest Float @default(1)
  totalServings    Float @default(0) // guestCount × servingsPerGuest

  // Costs (calculated from recipe totalCost, scaled)
  unitCost    Float   @default(0)  // cost per serving
  totalCost   Float   @default(0)  // unitCost × totalServings

  notes       String?
  order       Int     @default(0)

  @@index([eventId])
  @@index([recipeId])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id          String      @id @default(cuid())
  entityType  String      // "Recipe" | "Event" | "Ingredient" | etc.
  entityId    String
  action      AuditAction
  userId      String?
  userName    String?
  fieldName   String?     // which field changed (for UPDATE)
  before      String?     // JSON string of previous value
  after       String?     // JSON string of new value
  createdAt   DateTime    @default(now())

  // Soft relations (optional FK)
  recipeId    String?
  recipe      Recipe?     @relation("RecipeAudit", fields: [recipeId], references: [id], onDelete: SetNull)
  eventId     String?
  event       Event?      @relation("EventAudit", fields: [eventId], references: [id], onDelete: SetNull)
  user        User?       @relation("UserAudit", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
